VITE_API_BASE_URL=http://localhost:8080

# Dominio público del sitio. De acá salen el canonical, las previsualizaciones al
# compartir (WhatsApp, Facebook), el sitemap.xml y el robots.txt del build. Sin barra final.
VITE_SITE_URL=https://rankpadel.pages.dev

# --- Marca del club ---------------------------------------------------------------
# Todo esto es opcional: sin nada definido sale RankPadel con su paleta.
# El rebranding completo está documentado en docs/REBRANDING.md. Se usa con
# `npm run dev -- --mode <club>` / `npm run build -- --mode <club>` sobre un .env.<club>.

# Qué archivo de src/styles/temas/ entra al build. Un nombre que no existe rompe el
# build a propósito, para que nadie entregue un sistema con los colores de otro club.
VITE_BRAND_THEME=rankpadel

VITE_BRAND_NAME=RankPadel
VITE_BRAND_LOCATION=Santiago del Estero
VITE_BRAND_COUNTRY=Argentina
VITE_BRAND_EMAIL=info@rankpadel.com
VITE_BRAND_PHONE=+54 9 385 123-4567

# Color de la barra del navegador en Android. ENTRE COMILLAS: sin ellas el `#` abre un
# comentario del .env y el valor llega vacío.
VITE_BRAND_THEME_COLOR="#06100a"

# Título y descripción del sitio. Se derivan del nombre y la ciudad; definirlos solo si
# el texto derivado no sirve.
# VITE_BRAND_TITLE=
# VITE_BRAND_DESCRIPTION=

# Imágenes del sitio público (src/config/imagenes.ts) y la de previsualización al
# compartir el link. Rutas de la raíz: salen de public/ o de public/marcas/<tema>/.
# VITE_BRAND_IMG_PORTADA=
# VITE_BRAND_IMG_CANCHA=
# VITE_BRAND_IMG_TORNEO=
# VITE_BRAND_IMG_AMBIENTE=
# VITE_BRAND_OG_IMAGE=
